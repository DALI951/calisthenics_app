{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid']) && newData.child('uid').val() === $uid"
      }
    },

    "liveSessions": {
      "$pairId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','handle','exercise','setNumber','totalSets','phase']) && newData.child('uid').val() === $uid && newData.child('phase').val().matches(/^(working|waiting|resting|finished)$/)"
        },
        "cheers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['handle','emoji'])"
          }
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
