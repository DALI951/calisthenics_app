# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase config is never committed — emulator-first dev + CI build without it.
android/app/google-services.json

# Generated source: regenerated by `dart run build_runner build` (locally and in CI).
lib/**/*.g.dart
lib/**/*.freezed.dart

# Release signing — NEVER committed. Local builds read android/key.properties;
# CI reconstructs it from repository secrets.
android/key.properties
*.jks
*.keystore